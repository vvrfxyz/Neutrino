TZ=Asia/Shanghai

# xray (node)
HOSTNET_ENABLE=true
XRAY_INBOUND_TAG=vless-reality
XRAY_VLESS_PORT=24443
XRAY_API_PORT=10085
XRAY_API_LISTEN=127.0.0.1
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_REALITY_SERVER_NAME=www.microsoft.com
XRAY_REALITY_PRIVATE_KEY=REPLACE_WITH_REALITY_PRIVATE_KEY
XRAY_REALITY_SHORT_ID=REPLACE_WITH_SHORT_ID

# node-agent identity
NODE_ID=1

# panel bootstrap (used only for first-time cert enroll)
PANEL_URL=https://panel.example.com
PANEL_MTLS_URL=https://panel.example.com:8443
ENROLL_CODE=REPLACE_WITH_ONE_TIME_CODE

# agent -> panel mTLS client files (persist on disk)
PANEL_MTLS_CA_CERT_PATH=/data/mtls/ca-bundle.crt
PANEL_MTLS_CLIENT_CERT_PATH=/data/mtls/node.crt
PANEL_MTLS_CLIENT_KEY_PATH=/data/mtls/node.key

# node-agent local (optional health endpoint; no auth; not required)
AGENT_HTTP_ADDR=127.0.0.1:9090

# node-agent -> xray (local gRPC)
XRAY_API_ADDR=127.0.0.1:10085
XRAY_FLOW=xtls-rprx-vision
XRAY_ACCESS_LOG_PATH=/var/log/xray/access.log
AGENT_ACCESS_LOG_TZ=UTC

# managed xray config apply (agent-local only; panel never sends commands/paths)
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
# If you're running xray in Docker (default compose), node-agent needs docker.sock mounted.
XRAY_RELOAD_ARGS_JSON=["docker","restart","neutrino-xray"]
# Optional: validate a config before applying it. Default off.
# XRAY_TEST_ARGS_JSON=["docker","exec","neutrino-xray","/usr/local/bin/xray","run","-test","-c","${NEUTRINO_CONFIG_PATH}"]

# state + queue
HOST_PROC_PATH=/host/proc
STATE_PATH=/data/agent/state.json
QUEUE_DIR=/data/agent/queue
QUEUE_MAX_BYTES=200000000
PUSH_BATCH_MAX_EVENTS=500

# polling
ACCESS_POLL_SEC=2
STATS_POLL_SEC=5
AGENT_RUNTIME_REPORT_SEC=2
AGENT_STATIC_FACTS_REPORT_SEC=1800

# Timezone used to bucket natural-month RX/TX totals.
AGENT_MONTH_TZ=Asia/Shanghai

# access 0-byte sampling (write amplification guard)
ACCESS_ZERO_BYTE_MAX_PER_MIN_PER_USER=30
ACCESS_ZERO_BYTE_MAX_PER_MIN_PER_USER_DEST=5

# mTLS client cert auto-renew (recommended)
CERT_RENEW_ENABLED=true
CERT_RENEW_BEFORE_DAYS=7
CERT_RENEW_CHECK_EVERY_HOURS=12
CERT_RENEW_MIN_RETRY_SEC=30
CERT_RENEW_MAX_RETRY_SEC=1800
