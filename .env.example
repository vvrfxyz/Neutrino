TZ=Asia/Shanghai
PANEL_TZ=Asia/Shanghai

# Panel
ADDR=:8080
DB_PATH=/data/neutrino.db
# Local on-disk backup destination (POST /api/v1/backups writes here).
BACKUP_DIR=/data/backups
SUB_BASE_URL=http://127.0.0.1:8080

ADMIN_USER=admin
ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD
ALLOW_BASIC_AUTH=false
ADMIN_SESSION_HOURS=24
API_KEY_HEADER=X-API-Key

# Agent -> panel mTLS listener (node-agent -> panel). No bearer tokens.
PANEL_AGENT_MTLS_ADDR=:8443
PANEL_AGENT_MTLS_CA_CERT_PATHS=/data/mtls/ca.crt
PANEL_AGENT_MTLS_SERVER_CERT_PATH=/data/mtls/panel-agent-server.crt
PANEL_AGENT_MTLS_SERVER_KEY_PATH=/data/mtls/panel-agent-server.key
# Signing CA used to issue node client certs during enroll/renew.
# Best practice: use an intermediate CA key here; do NOT store a root CA key on the server.
PANEL_AGENT_MTLS_SIGNING_CA_CERT_PATH=/data/mtls/issuing-ca.crt
PANEL_AGENT_MTLS_SIGNING_CA_KEY_PATH=/data/mtls/issuing-ca.key
# Hardening: require an intermediate CA (not self-signed) for signing. Keep false for local dev if using a root CA.
PANEL_AGENT_MTLS_SIGNING_REQUIRE_INTERMEDIATE=false
# Refuse group/world-readable signing keys by default.
PANEL_AGENT_MTLS_SIGNING_REQUIRE_STRICT_KEY_PERMS=true

# Panel reconciler (desired/applied aligner) + job policies
NODE_RECONCILE_EVERY_SEC=30
NODE_RECONCILE_BACKOFF_SEC=300
NODE_JOB_MAX_ATTEMPTS=5
# Disabled by default; set a positive value to auto-disable stale nodes.
NODE_STALE_DELETE_AFTER_SEC=0

# Node deploy helper defaults (shown on /nodes/{id}/deploy)
NODE_DEFAULT_AGENT_IMAGE=ghcr.io/vvrfxyz/neutrino-node:latest
NODE_DEFAULT_XRAY_IMAGE=ghcr.io/xtls/xray-core:26.2.6
NODE_DEFAULT_DEPLOY_DIR=/root/neutrino-node
# Optional: explicit mTLS endpoint shown on /nodes/{id}/deploy.
# Set this when admin UI domain is behind CDN/proxy but mTLS:8443 must bypass proxy.
# Example: https://mtls.example.com:8443
NODE_DEFAULT_PANEL_MTLS_URL=
NODE_ENROLL_CODE_TTL_MIN=10

# Proxy publish (used for generating links/subscriptions)
PROXY_PUBLIC_HOST=YOUR_SERVER_IP_OR_DOMAIN
PROXY_PUBLIC_PORT=24443
PROXY_TYPE=tcp
PROXY_SECURITY=reality
PROXY_FLOW=xtls-rprx-vision
PROXY_SNI=www.microsoft.com
REALITY_FP=chrome
REALITY_PUBLIC_KEY=REPLACE_WITH_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=REPLACE_WITH_SHORT_ID

# Ops host-level metrics (optional)
# If set, panel reads host network counters from this mounted host /proc path.
HOST_PROC_PATH=/host/proc
OPS_SNAPSHOT_INTERVAL_SEC=2
HOST_METRICS_INTERVAL_SEC=2
ENABLE_OPS_V2=false
AGENT_MONTH_TZ=Asia/Shanghai
# If enabled, deploy script will include docker-compose.hostnet.yml.
HOSTNET_ENABLE=false
ONLINE_WINDOW_SEC=120
ONLINE_DISPLAY_WINDOW_SEC=300
IP_LIMIT_STRIKES=3
QUOTA_SWEEP_SEC=30

XRAY_ACCESS_RETENTION_DAYS=7
XRAY_STATS_RETENTION_DAYS=2
ONLINE_SESSIONS_RETENTION_DAYS=1
NODE_METRIC_SAMPLE_RETENTION_DAYS=14
NODE_METRIC_DETAIL_RETENTION_HOURS=72
NODE_PROBE_RESULT_RETENTION_DAYS=30
OPS_ALERT_RESOLVED_RETENTION_DAYS=90
# Usage dedupe keys; must exceed the agent replay window (26h backdate cap +
# disk-queue flush delay). Floor of 3 days is enforced.
USAGE_EVENT_KEY_RETENTION_DAYS=14
PRUNE_EVERY_SEC=3600

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
