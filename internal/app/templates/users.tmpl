{{define "page-content"}}
{{$d := .Content}}
<!-- Page header -->
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">用户管理</h1>
    <p class="text-sm text-slate-500 mt-1">管理代理用户、配额和订阅</p>
  </div>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <a href="/users" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 sm:w-auto">
      <i data-lucide="refresh-cw" class="w-4 h-4"></i> 刷新
    </a>
    <button x-data x-on:click="$dispatch('open-create-panel')"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700 sm:w-auto">
      <i data-lucide="plus" class="w-4 h-4"></i> 创建用户
    </button>
  </div>
</div>

<!-- Create user slide-over panel -->
<div x-data="{ open: false }" x-on:open-create-panel.window="open = true" x-on:user-created.window="open = false" x-on:keydown.escape.window="open = false">
  <!-- Backdrop -->
  <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-40 bg-black/30" x-on:click="open = false" x-cloak></div>
  <!-- Panel -->
  <div x-show="open" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
       x-transition:leave="transition ease-in duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
       class="fixed top-0 right-0 z-50 h-full w-full max-w-full bg-white shadow-2xl sm:max-w-md" x-cloak>
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900">创建用户</h2>
      <button x-on:click="open = false" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form class="space-y-4 overflow-y-auto p-4 sm:p-6" hx-post="/users" hx-target="#users-data" hx-swap="innerHTML">
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1">用户名</label>
        <input name="username" required placeholder="例如 user001"
               class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">月流量上限 (GB)</label>
          <input name="monthly_limit_gb" type="number" min="1" value="500" required
                 class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">计量模式</label>
          <select name="counting_mode"
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="double">双向 (入+出)</option>
            <option value="single">单向 (仅出站)</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">有效期 (天)</label>
          <input name="plan_days" type="number" min="1" value="30" required
                 class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">流量周期</label>
          <select name="quota_cycle"
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="month">月</option>
            <option value="week">周</option>
            <option value="day">日</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">时区</label>
          <input name="quota_tz" value="Asia/Shanghai" required
                 class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">IP 上限</label>
          <input name="device_limit" type="number" min="1" value="2" required
                 class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
      </div>
      {{if $d.Nodes}}
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-2">可用节点</label>
        <p class="text-xs text-slate-400 mb-2">不勾选则表示可使用全部节点</p>
        <div class="space-y-2 max-h-40 overflow-y-auto rounded-lg border border-slate-200 p-3">
          {{range $d.Nodes}}
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="node_ids" value="{{.ID}}"
                   class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
            <span class="text-sm text-slate-700">{{.Name}}</span>
            <span class="text-xs text-slate-400">({{.Protocol}} · {{.Host}}:{{.Port}})</span>
          </label>
          {{end}}
        </div>
      </div>
      {{end}}
      <div class="pt-2">
        <button type="submit"
                class="w-full py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors">
          创建用户
        </button>
      </div>
    </form>
  </div>
</div>

{{if $d.Error}}
<div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">{{$d.Error}}</div>
{{end}}

<!-- Users data -->
<div id="users-data">
  {{template "users_table.tmpl" $d.Users}}
</div>
{{end}}
