{{define "page-content"}}
{{$d := .Content}}
<!-- Header -->
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">节点管理</h1>
    <p class="text-sm text-slate-500 mt-1">管理代理节点、部署和监控</p>
  </div>
  <button x-data x-on:click="$dispatch('open-node-modal')"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700 sm:w-auto">
    <i data-lucide="plus" class="w-4 h-4"></i> 添加节点
  </button>
</div>

<!-- Node grid -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  {{range $d.Nodes}}
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 {{if .LastSeenAt}}bg-emerald-500{{else}}bg-slate-300{{end}}"></span>
        <h3 class="font-semibold text-slate-900">{{.Name}}</h3>
        {{if .Managed}}<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-blue-50 text-blue-600">托管</span>{{end}}
      </div>
      <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded {{if .Enabled}}bg-emerald-50 text-emerald-600{{else}}bg-slate-100 text-slate-500{{end}}">{{if .Enabled}}enabled{{else}}disabled{{end}}</span>
    </div>

    <div class="space-y-1 text-xs text-slate-600 mb-3">
      <div class="flex items-center gap-2"><span class="text-slate-400 w-14">类型</span> <span class="font-medium">{{.CoreType}} / {{.Protocol}}</span></div>
      <div class="flex items-center gap-2"><span class="text-slate-400 w-14">地址</span> <span class="font-mono">{{.Host}}:{{.Port}}</span></div>
      {{if .LastSeenAt}}<div class="flex items-center gap-2"><span class="text-slate-400 w-14">心跳</span> {{.LastSeenAt}}</div>{{end}}
      {{if .DesiredUsersVersion}}<div class="flex items-center gap-2"><span class="text-slate-400 w-14">Users</span> <span class="font-mono">{{shortHash .DesiredUsersVersion}}</span>/<span class="font-mono">{{shortHash .AppliedUsersVersion}}</span></div>{{end}}
      {{if .DesiredXrayVersion}}<div class="flex items-center gap-2"><span class="text-slate-400 w-14">Xray</span> <span class="font-mono">{{shortHash .DesiredXrayVersion}}</span>/<span class="font-mono">{{shortHash .AppliedXrayVersion}}</span></div>{{end}}
    </div>

    {{if .LastError}}
    <div class="text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2 mb-3">{{.LastError}}</div>
    {{end}}

    <div class="flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-100">
      <a href="/nodes/{{.ID}}/deploy" class="px-2.5 py-1 text-xs font-medium text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors">部署</a>
      {{if .Enabled}}
      <button class="px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-md transition-colors"
              hx-post="/api/v1/nodes/{{.ID}}/disable" hx-swap="none" hx-on::after-request="if(event.detail.successful) location.reload()">禁用</button>
      {{else}}
      <button class="px-2.5 py-1 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-md transition-colors"
              hx-post="/api/v1/nodes/{{.ID}}/enable" hx-swap="none" hx-on::after-request="if(event.detail.successful) location.reload()">启用</button>
      {{end}}
      <a href="/nodes/{{.ID}}/deploy#certs" class="px-2.5 py-1 text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-md transition-colors">证书/Jobs</a>
      <button class="px-2.5 py-1 text-xs font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-md transition-colors"
              hx-confirm="确认删除该节点？" hx-delete="/api/v1/nodes/{{.ID}}" hx-swap="none" hx-on::after-request="if(event.detail.successful) location.reload()">删除</button>
    </div>
  </div>
  {{else}}
  <div class="col-span-full bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center text-sm text-slate-400">
    暂无节点，点击上方按钮添加
  </div>
  {{end}}
</div>

<!-- Create node modal -->
<div x-data="{ open: false }" x-on:open-node-modal.window="open = true" x-on:keydown.escape.window="open = false">
  <div x-show="open" x-cloak class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" x-on:click="open = false"></div>
    <div x-transition class="relative mx-4 max-h-[calc(100vh-2rem)] w-full max-w-md overflow-y-auto rounded-xl bg-white p-4 shadow-2xl sm:p-6">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">添加节点</h2>
        <button x-on:click="open = false" class="p-1 text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form hx-post="/api/v1/nodes" hx-swap="none" x-on:htmx:after-request.window="if($event.detail.successful) location.reload()" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">名称</label>
          <input type="text" name="name" required class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">核心类型</label>
            <select name="core_type" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="xray">Xray</option>
              <option value="singbox">Sing-box</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">协议</label>
            <select name="protocol" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    onchange="(function(v){var p=document.getElementById('create-node-port'); if(!p) return; if(v==='vless_reality') p.value=443; else if(v==='hysteria2'||v==='tuic') p.value=8443;})(this.value)">
              <option value="vless_reality">VLESS Reality</option>
              <option value="hysteria2">Hysteria2</option>
              <option value="tuic">TUIC</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">主机</label>
          <input type="text" name="host" placeholder="可留空，将使用节点上报 IP" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">端口</label>
          <input id="create-node-port" type="number" name="port" value="443" required class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="managed" value="1" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
            托管配置（managed）
          </label>
        </div>
        <button type="submit" class="w-full py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors">创建</button>
      </form>
    </div>
  </div>
</div>
{{end}}
