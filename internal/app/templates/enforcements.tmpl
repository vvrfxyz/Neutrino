{{define "page-content"}}
{{$d := .Content}}
<!-- Header -->
<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-900">执行记录</h1>
  <p class="text-sm text-slate-500 mt-1">用户状态变更、限额、设备数等操作审计日志</p>
</div>

<!-- Log list -->
<div class="space-y-4 md:hidden">
  {{range $d.Items}}
  <article class="{{surfaceCardClass}}">
    <div class="border-b border-slate-100 px-4 py-4">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="text-sm font-semibold text-slate-900">{{.Username}}</div>
          <div class="mt-1 text-xs text-slate-400">#{{.UserID}}</div>
        </div>
        <div class="text-right">
          <div class="font-mono text-[11px] text-slate-500">{{.CreatedAt.Local.Format "2006-01-02"}}</div>
          <div class="font-mono text-[11px] text-slate-400">{{.CreatedAt.Local.Format "15:04:05"}}</div>
        </div>
      </div>
    </div>
    <div class="space-y-3 px-4 py-4 text-xs">
      <div class="flex flex-wrap gap-2">
        <code class="rounded bg-slate-100 px-2 py-1 font-mono text-slate-700">{{.Action}}</code>
        <code class="rounded bg-slate-100 px-2 py-1 font-mono text-slate-600">{{.Reason}}</code>
      </div>
      <div>
        <div class="mb-1 text-slate-400">Detail</div>
        <div class="break-all whitespace-pre-wrap {{softStatClass "leading-relaxed text-slate-600"}}">{{.Detail}}</div>
      </div>
    </div>
  </article>
  {{else}}
  <div class="{{emptyStateClass}}">暂无记录</div>
  {{end}}
</div>

<div class="hidden {{surfaceCardClass}} md:block">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] text-sm">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50">
          <th class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-4">时间</th>
          <th class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-4">用户</th>
          <th class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-4">Action</th>
          <th class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-4">Reason</th>
          <th class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 sm:px-4">Detail</th>
        </tr>
      </thead>
      <tbody>
        {{range $d.Items}}
        <tr class="border-b border-slate-100 hover:bg-slate-50/50">
          <td class="px-3 py-2.5 font-mono text-xs text-slate-500 sm:px-4">{{.CreatedAt.Local.Format "2006-01-02 15:04:05"}}</td>
          <td class="px-3 py-2.5 text-xs sm:px-4"><span class="text-slate-400">#{{.UserID}}</span> <span class="font-medium text-slate-700">{{.Username}}</span></td>
          <td class="px-3 py-2.5 sm:px-4"><code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-700">{{.Action}}</code></td>
          <td class="px-3 py-2.5 sm:px-4"><code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-600">{{.Reason}}</code></td>
          <td class="max-w-md break-all whitespace-pre-wrap px-3 py-2.5 text-xs text-slate-600 sm:px-4">{{.Detail}}</td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="px-3 py-12 text-center text-sm text-slate-400 sm:px-4">暂无记录</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</div>
{{end}}
